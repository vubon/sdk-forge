# frozen_string_literal: true

require_relative 'lib/{{.SDKName}}/version'

Gem::Specification.new do |spec|
  spec.name          = {{.SDKName | quote}}
  spec.version       = {{.ModuleName}}::VERSION
  spec.authors       = ['Auto-generated']
  spec.email         = ['noreply@example.com']

  spec.summary       = {{.Description | quote}}
  spec.description   = {{.Description | quote}}
  spec.homepage      = 'https://github.com/example/{{.SDKName}}'
  spec.license       = 'MIT'

  spec.required_ruby_version = '>= {{.RubyVersion}}'

  spec.files = Dir['lib/**/*.rb', 'README.md', 'LICENSE']
  spec.require_paths = ['lib']

  {{if .HTTPLibDependency}}
  spec.add_dependency '{{.HTTPLibDependency}}'
  {{end}}

  spec.add_development_dependency 'rspec', '~> 3.0'
  spec.add_development_dependency 'rubocop', '~> 1.0'
  spec.add_development_dependency 'yard', '~> 0.9'
  spec.add_development_dependency 'webmock', '~> 3.0'
end

